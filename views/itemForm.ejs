<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %></title>
		<link rel="stylesheet" href="/form.css" />
	</head>
	<body>
		<h1><%= title %></h1>
		<%- include("partials/errors.ejs") %>
		<form action="/itemForm/<%= category_id %>" method="post">
			<div class="formContainer">
				<label for="name">Enter the name of the item: </label>
				<input
					type="text"
					id="name"
					name="name"
					value="<%= item_name %>"
				/>
				<label for="description"
					>Enter the item description (optional):
				</label>
				<textarea name="description" id="description">
<%= item_desc %></textarea
				>
				<input
					type="hidden"
					value="<%= old_item_name %>"
					name="old_item_name"
				/>
				<button type="submit">Submit</button>
			</div>
		</form>
	</body>
</html>
