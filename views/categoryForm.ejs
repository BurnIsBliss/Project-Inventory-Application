<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %></title>
		<link rel="stylesheet" href="/form.css" />
	</head>
	<body>
		<h1><%= title %></h1>
		<%- include("partials/errors.ejs") %>
		<form action="/categoryForm/<%= old_category_name %>" method="post">
			<div class="formContainer">
				<label for="name">Enter the name of the category: </label>
				<input
					type="text"
					id="name"
					name="name"
					value="<%= category_name %>"
				/>
				<label for="description"
					>Enter the item description (optional):
				</label>
				<textarea name="description" id="description">
<%= category_desc %></textarea
				>
				<% if (title=='Edit Category') {%>
				<label for="password">Enter password:</label>
				<input type="password" name="password" id="password" />
				<%}%>
				<input
					type="hidden"
					value="<%= old_category_name %>"
					name="old_category_name"
				/>
				<button type="submit">Submit</button>
			</div>
		</form>
	</body>
</html>
